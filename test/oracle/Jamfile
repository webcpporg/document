# document's oracle: JavaScript itself, which parses every case's text with
# JSON.parse, applies its operations and writes the result with
# JSON.stringify. It needs no package: package.json names none.

import webcpp ;

webcpp.original node ;
webcpp.cases document : oracle.mjs : ../fixtures/cases : ../fixtures/expected ;
webcpp.lane oracle : cases-document ;
